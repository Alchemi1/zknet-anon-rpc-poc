# ZKNetwork + Anon-RPC PoC
# Environment Configuration

# Ethereum RPC for contract deployment (default: Sepolia)
RPC_URL=https://ethereum-sepolia.publicnode.com

# Private key for contract deployment (must have Sepolia ETH)
PRIVATE_KEY=

# walletshield listen addresses
WS_HTTP_ADDR=127.0.0.1:9200
WS_KPS_ADDR=0.0.0.0:9201
